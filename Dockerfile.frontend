FROM node:22-alpine

# Install system dependencies untuk export (Puppeteer, ffmpeg, dll)
RUN apk add --no-cache \
  chromium \
  ffmpeg \
  nss \
  freetype \
  harfbuzz \
  ca-certificates

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (BOTH prod + dev untuk vite, api handlers, dll)
RUN NODE_ENV=development npm ci

# Tell Puppeteer to use system chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Copy application files
COPY . .

# Expose port (unified single port)
EXPOSE 3373

# Start dev server dengan --host 0.0.0.0 agar accessible dari host/tailscale
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
